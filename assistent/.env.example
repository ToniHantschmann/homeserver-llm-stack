# Kopieren nach .env (nie committen). Alle Werte außer LITELLM_API_KEY haben Defaults.
ASSISTENT_VAULT=/mnt/data/llm/vault
# Private iCal-Adresse aus Google Calendar (Einstellungen → Kalender → "Privatadresse im iCal-Format").
# Mehrere Quellen kommagetrennt; lokale .ics-Pfade gehen auch.
ASSISTENT_ICAL=
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# Am besten ein eigener virtueller Key statt des Master-Keys:
#   cd ~/docker/llm-stack && . ./.env && curl -s http://127.0.0.1:4000/key/generate \
#     -H "Authorization: Bearer $LITELLM_MASTER_KEY" -H 'Content-Type: application/json' \
#     -d '{"key_alias":"assistent","models":["assistent","assistent-cloud"]}'
LITELLM_API_KEY=
ASSISTENT_MODELL=assistent
# ASSISTENT_WEEKLY_MUSTER=03 - notes/Wochenplanung KW {kw:02d}.md
# ASSISTENT_TAG_BEGINN=8
# ASSISTENT_TAG_ENDE=21
# Bearer-Token fuer die HTTP-API (Phase 5), mind. 24 Zeichen: openssl rand -hex 32
# Derselbe Wert steht in Home Assistant secrets.yaml (assistent_api_auth: "Bearer <token>").
ASSISTENT_API_TOKEN=
