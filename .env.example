# LLM-Stack Secrets - nach .env kopieren, nie committen.
# LITELLM_SALT_KEY verschluesselt gespeicherte Provider-Keys in der DB: NACH dem ersten Start NIE mehr aendern.
#   openssl rand -hex 32
LITELLM_MASTER_KEY=sk-
LITELLM_SALT_KEY=
LITELLM_DB_PASSWORD=
# Optional: Cloud-Alias assistent-cloud. Leer = rein lokal (Standard).
ANTHROPIC_API_KEY=
