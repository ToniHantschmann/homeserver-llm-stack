# livesync-bridge Secrets - nach vault.env kopieren (chmod 600), nie committen.
# Werte mit Sonderzeichen (insb. $) in EINFACHE Anfuehrungszeichen setzen,
# sonst interpoliert docker compose sie.
VAULT_COUCHDB_URL=http://obsidian-livesync:5984
VAULT_COUCHDB_DB=obsidian-vault
# Eigener Nicht-Admin-User, nur Mitglied dieser einen DB (siehe ops/03-vault-bridge-prod.sh)
VAULT_COUCHDB_USER=livesync-bridge
VAULT_COUCHDB_PASSWORD=
# E2EE-Passphrase aus Obsidian -> Self-hosted LiveSync -> Remote Configuration
VAULT_PASSPHRASE=
